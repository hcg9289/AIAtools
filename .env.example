# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model (default: google/gemini-3.1-flash-lite-preview)
AI_MODEL=google/gemini-3.1-flash-lite-preview

# Portal authentication uses /run/secrets/portal_service_key in production.
# Environment fallback is intended only for local tests/development.
PORTAL_SERVICE_KEY=replace_with_test_only_key
